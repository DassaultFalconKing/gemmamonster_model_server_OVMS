{
    "manifest_version":  3,
    "name":  "OMP Browser Relay",
    "version":  "0.1.0",
    "description":  "Lets the omp coding agent drive your existing tabs through a local CDP relay.",
    "author":  "Stencil Labs, Inc.",
    "homepage_url":  "https://omp.sh",
    "permissions":  [
                        "debugger",
                        "tabs",
                        "tabGroups",
                        "storage",
                        "alarms"
                    ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "options_page":  "options.html",
    "action":  {
                   "default_title":  "OMP Browser Relay (click for settings)",
                   "default_icon":  {
                                        "24":  "icons/relay-24.png",
                                        "16":  "icons/relay-16.png",
                                        "32":  "icons/relay-32.png"
                                    }
               },
    "version_name":  "18.14.0",
    "icons":  {
                  "16":  "icons/relay-16.png",
                  "128":  "icons/relay-128.png",
                  "48":  "icons/relay-48.png",
                  "32":  "icons/relay-32.png"
              }
}