+// Diagnostic-only: stable source string for a run-local grammar fingerprint.
+// Pure observation: does not affect compilation, caching, or matching behavior.
+// Uses StructuredOutputConfig::structural_tag_to_json, which covers every
+// StructuralTag alternative (value and shared_ptr forms); legacy
+// StructuralTagsConfig keeps its own to_json().
+std::string grammar_fingerprint_source(const ov::genai::StructuredOutputConfig& cfg) {
+    using SOC = ov::genai::StructuredOutputConfig;
+    if (cfg.json_schema.has_value()) {
+        return std::string("json_schema:") + cfg.json_schema.value();
+    }
+    if (cfg.regex.has_value()) {
+        return std::string("regex:") + cfg.regex.value();
+    }
+    if (cfg.grammar.has_value()) {
+        return std::string("ebnf:") + cfg.grammar.value();
+    }
+    auto variant_source = [](const auto& v) -> std::string {
+        return std::visit([](const auto& g) -> std::string {
+            using T = std::decay_t<decltype(g)>;
+            if constexpr (std::is_same_v<T, std::string>) {
+                return g;
+            } else if constexpr (std::is_same_v<T, ov::genai::StructuralTagsConfig>) {
+                return g.to_json();
+            } else if constexpr (std::is_same_v<T, SOC::StructuralTag>) {
+                return std::visit([](const auto& h) -> std::string {
+                    return SOC::structural_tag_to_json(h);
+                }, g);
+            } else {
+                return SOC::structural_tag_to_json(g);
+            }
+        }, v);
+    };
+    if (cfg.structural_tags_config.has_value()) {
+        return std::string("structural:") + variant_source(cfg.structural_tags_config.value());
+    }
+    if (cfg.compound_grammar.has_value()) {
+        return std::string("compound:") + variant_source(cfg.compound_grammar.value());
+    }
+    return "none";
+}
